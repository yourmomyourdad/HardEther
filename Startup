pkill node || true
pkill Xvfb || true
pkill unclutter || true
pkill chromium || true

Xvfb :99 -screen 0 1280x720x24 -ac &

sleep 2

DISPLAY=:99 unclutter -display :99 -idle 0 &

DISPLAY=:99 chromium \
    --no-sandbox \
    --disable-setuid-sandbox \
    --user-data-dir="$PWD/browser-profile" \
    --app=about:blank \
    --no-first-run \
    --no-default-browser-check \
    --disable-session-crashed-bubble \
    --disable-infobars \
    about:blank &

sleep 3

DISPLAY=:99 node server.js
